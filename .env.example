DATABASE_URL="postgresql://shipment_tracker:shipment_tracker@localhost:5432/shipment_tracker"
PORT=3001
# API log level: fatal, error, warn, info (default), debug, trace or silent.
# LOG_LEVEL=info
# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET="change-me-in-production-min-32-characters"
# Auth cookies are always Secure. Uncomment only if your local browser rejects Secure cookies
# over http://localhost (Safari does; Chrome and Firefox accept them).
# COOKIE_SECURE=false
# HMAC key of POST /api/v1/webhooks/carrier; `npm run simulate -w apps/api` signs with it too.
# At least 32 characters. Generate one with: openssl rand -base64 48
WEBHOOK_SECRET="change-me-too-webhook-secret-min-32-chars"
# Frontend (apps/web): origin of the API that Next.js proxies /api/v1/* to — scheme and host, no path.
# Defaults to http://localhost:3001; required when building on Vercel. Next.js reads it from
# apps/web/.env.local or from the shell environment.
# API_ORIGIN="http://localhost:3001"
